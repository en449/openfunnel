# ---------------------------------------------------------------------------
# OpenFunnel environment
# Copy to `.env.local` and fill in. Nothing here is required to run the local
# `demo/` (it works fully offline). These are for the Next.js runtime + Supabase.
# ---------------------------------------------------------------------------

# --- Supabase (funnel storage, leads, analytics events) ---
# Found in your Supabase project settings → API.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Used by edge functions / server routes. NEVER expose to the client.
SUPABASE_SERVICE_ROLE_KEY=

# --- Pixels / analytics (optional; per-funnel config can override these) ---
# --- Email Notifications & Autoresponders (optional) ---
# Admin notification recipient
NOTIFY_EMAIL=owner@yourdomain.com

# Provider: "resend", "smtp", or "none"
EMAIL_PROVIDER=resend

# Resend API
RESEND_API_KEY=
RESEND_FROM="OpenFunnel Leads <leads@yourdomain.com>"

# SMTP Relay (alternative to Resend)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="OpenFunnel <noreply@yourdomain.com>"

