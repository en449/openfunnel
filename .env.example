# ---------------------------------------------------------------------------
# OpenFunnel environment
# Copy to `.env.local` and fill in. Every value here is optional: with an empty
# file the Bun runtime still serves funnels and stores leads as JSONL on disk,
# and the offline `demo/` needs nothing at all. There is no Next.js here — the
# whole backend is apps/runtime/server.js.
#
# The one line to read before deploying is ADMIN_TOKEN, below.
# ---------------------------------------------------------------------------

# --- Runtime basics ---
# Port to listen on (default 3000).
PORT=3000
# Where funnel JSON documents are read and written. The console saves into here.
FUNNELS_DIR=examples/
# Where leads.jsonl, events.jsonl and email_settings.json are written. Contains
# real lead PII — keep it off any path your web server hands out directly.
DATA_DIR=.data/

# --- Supabase (funnel storage, leads, analytics events) ---
# Found in your Supabase project settings → API.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Used by edge functions / server routes. NEVER expose to the client.
SUPABASE_SERVICE_ROLE_KEY=

# --- Admin access (REQUIRED before exposing this server publicly) ---
# Guards every console API: reading leads, saving funnels, changing mail
# settings, sending mail. Leave blank and the server accepts those routes only
# from localhost, so local development needs no setup — but any deployment
# reachable off-host MUST set this or the console APIs stay locked.
# Generate one with:  openssl rand -hex 32
# Paste the same value into the console under Settings → Admin API token.
ADMIN_TOKEN=

# Set to 1 only if a proxy/CDN in front of this server rewrites the client
# address. x-forwarded-for is caller-supplied, so it is ignored without this —
# otherwise every per-IP limit is bypassed by rotating a header. Your proxy must
# REPLACE the header, not append to it.
TRUST_PROXY=

# Extra hostnames permitted to use loopback trust when ADMIN_TOKEN is unset.
# Only needed if you reach the console by a name other than localhost without a
# token. Anything not listed is refused, which is what stops a DNS-rebinding page
# from reaching the console's APIs through your own browser.
ALLOWED_HOSTS=

# Ceiling on outbound mail per hour across all callers (OTP, autoresponder and
# lead notifications each get their own bucket). Default 500.
MAIL_MAX_PER_HOUR=

# --- Meta Conversions API (optional, server-side) ---
# These two names are what the server actually reads. Earlier revisions of this
# file listed NEXT_PUBLIC_META_PIXEL_ID / META_CAPI_ACCESS_TOKEN, which nothing
# reads — following that template gave a silently inert CAPI. The NEXT_PUBLIC_
# prefix was the worse half: it belongs to browser-exposed values, and this
# token can write conversions into your ad account.
# Sends visitor IP and user-agent to Meta — see "Third-party data sharing" in
# the README before enabling.
META_PIXEL_ID=
META_CAPI_TOKEN=

# Browser pixel ids (Meta, GTM, GA4, TikTok) are NOT set here. They live on each
# funnel document under `integrations`, editable in the console's Pixels modal.

# --- Email Notifications & Autoresponders (optional) ---
# Admin notification recipient
NOTIFY_EMAIL=owner@yourdomain.com

# Provider: "resend", "smtp", or "none"
EMAIL_PROVIDER=resend

# Resend API
RESEND_API_KEY=
RESEND_FROM="OpenFunnel Leads <leads@yourdomain.com>"

# SMTP credentials. NOTE: direct SMTP is not implemented — these are stored for
# a future transport. To actually deliver mail, use Resend above or the relay
# below. Setting only SMTP_* will log a warning and send nothing.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="OpenFunnel <noreply@yourdomain.com>"

# Optional HTTP-to-SMTP relay. Every outgoing message is POSTed here as JSON.
# Deliberately env-only and never settable through the API — a relay URL that
# could be changed remotely would forward every lead to whoever changed it.
SMTP_RELAY_URL=

# --- Webhook forwarding (optional: Zapier, Make, GoHighLevel, HubSpot, n8n) ---
# Every captured lead is POSTed here server-side, so the endpoint never appears
# in the funnel page. Read only from this environment or from the funnel
# document — never from the request body, because /api/lead is public.
# Destinations resolving to loopback, private ranges, link-local or the cloud
# metadata address are refused.
WEBHOOK_URL=
# Legacy alias for WEBHOOK_URL, still read as a fallback.
ZAPIER_WEBHOOK_URL=
# Sent as the X-Webhook-Secret header so your automation can verify the sender.
WEBHOOK_SECRET=

# --- AI copilot (optional) ---
# Used by the admin-only /api/ai/generate route. Only a key beginning "sk-" is
# sent to OpenAI; with anything else (or nothing) the route silently falls back
# to a hardcoded built-in generator, so a successful response does NOT mean a
# model ran. The console can also supply a key per request from its own
# settings, in which case this is not needed.
OPENAI_API_KEY=

# --- Misc ---
# Set to "production" to enable the 60s funnel cache and long-lived asset
# caching. Anything else (including unset) is treated as development.
NODE_ENV=

# --- Custom code injection (optional) ---
# The console can attach customCss / customHead / customBody to a funnel, and the
# funnel page injects them raw. Script inside them is REFUSED unless you opt in
# here, and that default is deliberate: a funnel page is served from the same
# origin as the console, and the admin token lives in that origin's
# localStorage — so a script on a funnel page can read it and drain
# /api/admin/*. Funnel documents also get imported from templates and bug
# reports, and executing whatever they carry would turn "I imported a funnel
# JSON" into console takeover.
#
# Opting in does NOT widen the policy to 'unsafe-inline'. Each inline script is
# allowed by the SHA-256 of its exact bytes and each external one by its own
# origin, so only what you pasted runs — an injected `step.consent` still cannot
# execute. With this off, a funnel carrying script logs a warning at request time
# rather than failing silently in the visitor's browser.
ALLOW_CUSTOM_SCRIPTS=

# Extra origins to allow when the above is on. A pasted tag manager or analytics
# loader often pulls further scripts from hosts that cannot be read off the
# snippet; list them here (space or comma separated) instead of opening https:
# wholesale. Example: https://www.clarity.ms https://static.hotjar.com
CUSTOM_SCRIPT_ORIGINS=
