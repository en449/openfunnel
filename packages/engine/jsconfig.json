{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "checkJs": true,
    "strict": true,
    "noEmit": true,
    // false on purpose. types/index.d.ts is the hand-maintained published
    // surface and is included below, so it must be checked, not skipped — it
    // silently drifted out of sync with src/types.js until it was added here.
    "skipLibCheck": false
  },
  "include": ["src/**/*.js", "types/**/*.d.ts"]
}
